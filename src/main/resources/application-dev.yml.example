spring:
  datasource:
    url: jdbc:sqlserver://${DB_HOST:localhost};databaseName=SaboresPeru;encrypt=true;trustServerCertificate=true
    username: ${DB_USER:sa}
    password: ${DB_PASSWORD:TuPassword}
    driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver
    hikari:
      maximum-pool-size: 10
      pool-name: HikariPool-Dev

  jpa:
    show-sql: true

logging:
  level:
    root: INFO
    com.saboresperu.restaurante: DEBUG
    org.hibernate.SQL: DEBUG